#include <windows.h>

1 ICON "cairn.ico"
1 RT_MANIFEST "cairn.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "ProductName", "Cairn"
      VALUE "FileDescription", "Cairn - local-first multimedia knowledge environment"
      VALUE "FileVersion", "0.10.0.0"
      VALUE "ProductVersion", "0.10.0.0"
      VALUE "InternalName", "cairn"
      VALUE "OriginalFilename", "cairn.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 0x04B0
  END
END
